{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kayba-ai.com/kyoko/schemas/learning-proposal.schema.json",
  "title": "Kyoko LearningProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "profile_id",
    "producer",
    "state",
    "section",
    "title",
    "summary",
    "confidence",
    "evidence_refs",
    "problem",
    "insight",
    "proposed_changes",
    "gate_expectations",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kyoko.learning_proposal.v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "profile_id": {
      "$ref": "#/$defs/id"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["operator_agent", "native_ace", "human", "system"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "agent_identity_id": {
          "$ref": "#/$defs/id"
        },
        "session_id": {
          "type": "string"
        },
        "raw_output_ref": {
          "$ref": "#/$defs/ref"
        },
        "ace_operations_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "applied",
        "rolled_back",
        "failed"
      ]
    },
    "section": {
      "type": "string",
      "enum": ["context", "harness"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "severity", "target"],
      "properties": {
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "root_cause": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/target_ref"
        }
      }
    },
    "insight": {
      "type": "string",
      "minLength": 1
    },
    "proposed_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/skillbook_update"
          },
          {
            "$ref": "#/$defs/check_spec"
          },
          {
            "$ref": "#/$defs/replay_request"
          },
          {
            "$ref": "#/$defs/harness_patch"
          },
          {
            "$ref": "#/$defs/context_delivery_rule"
          }
        ]
      }
    },
    "gate_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_human_review", "requires_check_level", "requires_replay"],
      "properties": {
        "requires_human_review": {
          "type": "boolean"
        },
        "requires_check_level": {
          "$ref": "#/$defs/check_trust_level"
        },
        "requires_replay": {
          "type": "boolean"
        },
        "allowed_autonomy_section": {
          "type": "string",
          "enum": ["context", "harness", "none"]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "entity_id", "role"],
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": [
            "run",
            "span",
            "task",
            "task_attempt",
            "handoff",
            "timeline_event",
            "issue",
            "check_run",
            "replay_run",
            "patch_transaction",
            "blob"
          ]
        },
        "entity_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string",
          "enum": ["failure", "context", "counterexample", "verification", "regression", "source"]
        },
        "quote_ref": {
          "$ref": "#/$defs/ref"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "target_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "entity_id"],
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": [
            "profile",
            "source",
            "agent_identity",
            "workflow_node",
            "run",
            "span",
            "task",
            "task_attempt",
            "handoff",
            "skill",
            "file",
            "unknown"
          ]
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "check_trust_level": {
      "type": "string",
      "enum": ["L0_generated", "L1_repeated", "L2_regression", "L3_human_approved"]
    },
    "side_effect_mode": {
      "type": "string",
      "enum": [
        "none",
        "filesystem_read",
        "sandboxed_filesystem",
        "network_mocked",
        "live_network",
        "unknown"
      ]
    },
    "skillbook_update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "operation", "section", "issue", "insight", "keywords", "occurrence_refs"],
      "properties": {
        "type": {
          "type": "string",
          "const": "skillbook_update"
        },
        "operation": {
          "type": "string",
          "enum": ["create", "update", "deactivate", "link_occurrence"]
        },
        "skill_id": {
          "$ref": "#/$defs/id"
        },
        "section": {
          "type": "string",
          "enum": ["context", "harness"]
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "insight": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "occurrence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      }
    },
    "check_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "check_type", "trust_level", "side_effect_mode", "definition"],
      "properties": {
        "type": {
          "type": "string",
          "const": "check_spec"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "check_type": {
          "type": "string",
          "enum": ["deterministic_assertion", "judge", "regression_replay", "smoke_run"]
        },
        "trust_level": {
          "$ref": "#/$defs/check_trust_level"
        },
        "side_effect_mode": {
          "$ref": "#/$defs/side_effect_mode"
        },
        "definition": {
          "type": "object"
        }
      }
    },
    "replay_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source_entity_type", "source_entity_id", "mode", "side_effect_mode"],
      "properties": {
        "type": {
          "type": "string",
          "const": "replay_request"
        },
        "source_entity_type": {
          "type": "string",
          "enum": ["run", "task_attempt"]
        },
        "source_entity_id": {
          "$ref": "#/$defs/id"
        },
        "mode": {
          "type": "string",
          "enum": ["dry_run", "sandbox", "live"]
        },
        "side_effect_mode": {
          "$ref": "#/$defs/side_effect_mode"
        },
        "tool_policy": {
          "type": "object"
        }
      }
    },
    "harness_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "patch_kind", "target_paths", "side_effect_mode", "rollback_required"],
      "properties": {
        "type": {
          "type": "string",
          "const": "harness_patch"
        },
        "patch_kind": {
          "type": "string",
          "enum": ["unified_diff", "generated_file", "command_plan"]
        },
        "target_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "diff_ref": {
          "$ref": "#/$defs/ref"
        },
        "command_plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string"
              },
              "executable": {
                "type": "boolean"
              }
            }
          }
        },
        "side_effect_mode": {
          "$ref": "#/$defs/side_effect_mode"
        },
        "rollback_required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "context_delivery_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "operation", "target", "rule"],
      "properties": {
        "type": {
          "type": "string",
          "const": "context_delivery_rule"
        },
        "operation": {
          "type": "string",
          "enum": ["create", "update", "deactivate"]
        },
        "target": {
          "$ref": "#/$defs/target_ref"
        },
        "rule": {
          "type": "object"
        }
      }
    }
  }
}
